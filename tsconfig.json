{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": ".test-dist",
    "rootDir": ".",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "index.mts",
    "src/**/*.mts",
    "test/**/*.mts",
    "src/client.mts"
  ]
}
